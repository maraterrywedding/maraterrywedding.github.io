# Copy to `.env` (or set as a GitHub repository *variable*) before building.
#
# The deployed Google Apps Script web app URL. It ends in /exec.
# This is NOT a secret — it is visible in the page source no matter what, and
# treating it as one gives false comfort. The real protections are the
# server-side deadline check, the honeypot field, and the invite code.
PUBLIC_RSVP_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec

# Only needed when the GitHub repo is NOT named <username>.github.io.
# PUBLIC_BASE=/bigday-wedding
# PUBLIC_SITE=https://<username>.github.io
