---
import type { Locale } from '@/i18n/locales';
import { guestSchedule } from '@/data/schedule';
import LocalizedText from './LocalizedText.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const entries = guestSchedule();
---

<ol class="timeline">
  {
    entries.map((entry) => (
      <li class:list={['timeline__item', entry.highlight && 'timeline__item--highlight']}>
        <div class="timeline__time">
          <time datetime={entry.time}>{entry.time}</time>
          {entry.until && (
            <>
              <span class="timeline__dash" aria-hidden="true">
                –
              </span>
              <time datetime={entry.until}>{entry.until}</time>
            </>
          )}
        </div>

        <div class="timeline__body">
          <LocalizedText value={entry.title} lang={lang} as="p" class="timeline__title" />
          {entry.note && (
            <LocalizedText value={entry.note} lang={lang} as="p" class="timeline__note" />
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* The spine. Sits behind the dots and stops short of the last item so the
     day reads as finishing rather than trailing off. */
  .timeline::before {
    content: '';
    position: absolute;
    inset-block: 0.75rem 3rem;
    inset-inline-start: 4.25rem;
    width: 2px;
    background: var(--c-lilac-200);
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--sp-5);
    padding-block: var(--sp-4);
  }

  .timeline__item::before {
    content: '';
    position: absolute;
    inset-block-start: 1.45rem;
    inset-inline-start: 3.9rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--c-lilac-300);
    outline: 4px solid var(--c-bg);
  }

  .timeline__item--highlight::before {
    background: var(--c-forest-600);
    width: 15px;
    height: 15px;
    inset-inline-start: 3.75rem;
    inset-block-start: 1.35rem;
  }

  .timeline__time {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--c-forest-700);
    line-height: 1.4;
  }

  .timeline__dash {
    color: var(--c-text-muted);
  }

  .timeline__body {
    padding-inline-start: var(--sp-2);
  }

  .timeline__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--c-heading);
    line-height: 1.3;
  }

  .timeline__item--highlight .timeline__title {
    font-weight: 600;
  }

  /* Needs real separation from the title above it. At only 8px apart the two
     read as one run-on paragraph, because the size difference alone is too
     subtle at this scale. */
  .timeline__note {
    margin-block-start: var(--sp-3);
    padding-inline-start: var(--sp-3);
    border-inline-start: 2px solid var(--c-lilac-200);
    font-size: var(--step--1);
    color: var(--c-text-muted);
    max-width: var(--measure);
  }
</style>
