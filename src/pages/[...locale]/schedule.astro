---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Timeline from '@/components/Timeline.astro';
import Photo from '@/components/Photo.astro';
import { localeStaticPaths } from '@/lib/routing';
import type { Locale } from '@/i18n/locales';
import { t } from '@/i18n/utils';
import { SCHEDULE_IS_PROVISIONAL } from '@/data/schedule';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };

/** A few pictures beside the running order. */
const asidePhotos = ['venueFromRiver', 'coupleRiver', 'venueSunset'] as const;
---

<Base lang={lang} path="/schedule" title={t(lang, 'schedule.title')}>
  <PageHeader
    lang={lang}
    title={t(lang, 'schedule.title')}
    intro={t(lang, 'schedule.intro')}
    provisional={SCHEDULE_IS_PROVISIONAL}
  />

  <section class="section">
    <div class="container schedule">
      <div>
        <Timeline lang={lang} />
      </div>

      <aside class="schedule__aside">
        {
          asidePhotos.map((name, i) => (
            <figure class="schedule__figure">
              <Photo
                name={name}
                lang={lang}
                widths={[400, 800]}
                sizes="(min-width: 60rem) 22rem, 100vw"
                ratio={i === 1 ? '4/5' : '4/3'}
                class="schedule__image"
              />
            </figure>
          ))
        }
      </aside>
    </div>
  </section>
</Base>

<style>
  .schedule {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .schedule {
      grid-template-columns: 1fr 22rem;
      gap: var(--sp-8);
    }
  }

  .schedule__aside {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .schedule__figure {
    margin: 0;
  }

  .schedule :global(.schedule__image) {
    border-radius: var(--radius-lg);
  }
</style>
