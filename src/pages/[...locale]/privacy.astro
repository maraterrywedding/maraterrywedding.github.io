---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import LocalizedText from '@/components/LocalizedText.astro';
import { localeStaticPaths } from '@/lib/routing';
import type { Locale } from '@/i18n/locales';
import { pickLocalized, t } from '@/i18n/utils';
import { CONSENT_VERSION, PRIVACY_SECTIONS } from '@/data/privacy';
import { formatDate } from '@/lib/format';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
---

<Base lang={lang} path="/privacy" title={t(lang, 'privacy.title')}>
  <PageHeader lang={lang} title={t(lang, 'privacy.title')} intro={t(lang, 'privacy.intro')} />

  <section class="section">
    <div class="container">
      <div class="policy prose">
        {
          PRIVACY_SECTIONS.map((section) => (
            <section class="policy__section" id={section.id}>
              <LocalizedText value={section.title} lang={lang} as="h2" note={false} />
              <LocalizedText value={section.body} lang={lang} as="p" />
              {section.bullets && (
                <ul class="policy__list">
                  {section.bullets.map((bullet) => (
                    <li>{pickLocalized(bullet, lang).value}</li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }

        <p class="policy__updated muted">
          {t(lang, 'privacy.lastUpdated', { date: formatDate(CONSENT_VERSION, lang) })}
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .policy__section + .policy__section {
    margin-block-start: var(--sp-6);
  }

  .policy__section h2 {
    font-size: var(--step-2);
    margin-block-end: var(--sp-3);
  }

  .policy__list {
    margin-block-start: var(--sp-3);
    padding-inline-start: var(--sp-5);
  }

  .policy__list li + li {
    margin-block-start: var(--sp-2);
  }

  .policy__updated {
    margin-block-start: var(--sp-7);
    padding-block-start: var(--sp-4);
    border-block-start: 1px solid var(--c-border);
    font-size: var(--step--1);
  }
</style>
