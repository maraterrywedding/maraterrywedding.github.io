---
import Base from '@/layouts/Base.astro';
import Photo from '@/components/Photo.astro';
import Countdown from '@/components/Countdown.astro';
import Weather from '@/components/Weather.astro';
import { localeStaticPaths } from '@/lib/routing';
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/locales';
import { localizedPath } from '@/lib/paths';
import { NAV, RSVP_PATH } from '@/lib/nav';
import { EVENT } from '@/data/event';
import { formatDate, formatDateWithWeekday, formatDayAndMonth } from '@/lib/format';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };

const ceremonyDate = formatDate(EVENT.ceremony, lang);
const fullDate = formatDateWithWeekday(EVENT.ceremony, lang);
const thursday = formatDayAndMonth(EVENT.coupleArrive, lang);

const nextUp = [
  { key: 'home.next.schedule', path: NAV[0]!.path, label: 'nav.schedule' },
  { key: 'home.next.travel', path: NAV[1]!.path, label: 'nav.travel' },
  { key: 'home.next.stay', path: NAV[2]!.path, label: 'nav.stay' },
];
---

<Base lang={lang} path="/">
  <section class="hero">
    <div class="hero__media">
      <Photo
        name="hero"
        lang={lang}
        loading="eager"
        widths={[600, 900, 1400, 2000]}
        sizes="100vw"
        class="hero__image"
      />
    </div>

    <div class="hero__body">
      <p class="hero__eyebrow">{t(lang, 'home.hero.intro')}</p>
      <h1 class="hero__names">{EVENT.couple.display}</h1>
      <p class="hero__date">
        <time datetime={EVENT.ceremony.slice(0, 10)}>{fullDate}</time>
      </p>
      <p class="hero__venue">{EVENT.venue.name} · {EVENT.venue.city}</p>

      <div class="hero__actions">
        <a class="button" href={localizedPath(lang, RSVP_PATH)}>{t(lang, 'home.hero.cta')}</a>
        <span class="hero__actions-note">{t(lang, 'home.hero.ctaSub')}</span>
      </div>
    </div>
  </section>

  <section class="section section--tint countdown-band">
    <div class="container">
      <Countdown lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="container save">
      <div class="save__text stack">
        <p class="eyebrow">{t(lang, 'home.saveTheDate.title')}</p>
        <h2>{ceremonyDate}</h2>
        {/* No times here on purpose — the running order is not settled, and
            the pill below is the whole story until it is. */}
        <p class="lead">{t(lang, 'home.saveTheDate.body')}</p>

        {
          !EVENT.ceremonyTimeConfirmed && (
            <p class="pill pill--quiet">{t(lang, 'home.hero.timeTbc')}</p>
          )
        }

        <p class="save__friday">{t(lang, 'home.hero.friday')}</p>

        <p class="save__thursday">
          {t(lang, 'home.saveTheDate.weAreThereFrom', { date: thursday })}
        </p>
      </div>

      <figure class="save__figure">
        <Photo
          name="venueFromRiver"
          lang={lang}
          widths={[400, 800, 1200]}
          sizes="(min-width: 48rem) 28rem, 100vw"
          class="save__image"
        />
      </figure>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <Weather lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="container stack-lg">
      <h2>{t(lang, 'home.next.title')}</h2>
      <ul class="next">
        {
          nextUp.map((item) => (
            <li>
              <a class="next__card" href={localizedPath(lang, item.path)}>
                <span class="next__label">{t(lang, item.label)}</span>
                <span class="next__desc">{t(lang, item.key)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */

  /* Photo and text are stacked in a single grid cell rather than positioned
     absolutely. That way the hero is always at least as tall as its text —
     on a narrow phone the copy can never spill up over the faces. */
  .hero {
    display: grid;
    isolation: isolate;
    min-height: min(92dvh, 46rem);
  }

  .hero > * {
    grid-area: 1 / 1;
  }

  .hero__media {
    position: relative;
    overflow: hidden;
  }

  .hero__media::after {
    /* Warm scrim: light at the top so the photo reads, deep at the bottom so
       the display type sits on solid ground. */
    content: '';
    position: absolute;
    inset: 0;
    /* Lighter through the middle than the previous hero needed. This photo is
       already warm and dim, and the old scrim turned it muddy — the fairy
       lights are the best thing in it. It still goes deep at the bottom, where
       the type actually sits. */
    background: linear-gradient(
      to bottom,
      rgb(22 40 29 / 0.06) 0%,
      rgb(22 40 29 / 0.08) 34%,
      rgb(22 40 29 / 0.42) 62%,
      rgb(22 40 29 / 0.88) 100%
    );
  }

  /* Absolutely positioned on purpose. As a normal in-flow child the image
     would size the grid row, and `height: 100%` would then be circular — the
     row depends on the image, the image depends on the row — so the browser
     falls back to the intrinsic 4:3 height and the hero grows to 960px.
     Taking it out of flow lets the row be sized by the text plus min-height,
     and the image simply fills whatever that turns out to be. */
  .hero :global(.hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Tuned to the current hero: the couple are centre-weighted, so the crop is
       pushed down to lift them clear of the bottom-anchored text. If this photo
       is ever swapped, expect to retune this AND the hero's min-height — the two
       together decide whether the names land on somebody's face. */
    object-position: center 55%;
  }

  .hero__body {
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--sp-6) var(--sp-5) var(--sp-7);
    color: var(--c-white);
    text-align: center;
    text-shadow: 0 1px 12px rgb(22 40 29 / 0.45);
  }

  /* Taller than it used to be, and deliberately so: at 40rem the crop was tight
     enough that the names landed directly on the couple's faces. The extra
     height shows more of the photo, which pushes the faces clear of the
     bottom-anchored text. */
  /* On a phone the image is height-constrained — it covers the box vertically
     and gets cropped at the sides — so `object-position` cannot lift the faces
     the way it does on desktop. The two levers that DO work are a taller box
     and a shorter text block: the faces scale with the box while the text stays
     a fixed height, so both widen the gap between them. */
  @media (max-width: 47.99rem) {
    .hero__names {
      font-size: var(--step-3);
    }

    .hero__date {
      font-size: var(--step-0);
    }

    .hero__body {
      padding-block-end: var(--sp-5);
    }

    .hero__actions {
      margin-block-start: var(--sp-4);
    }
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: min(90dvh, 50rem);
    }
  }

  .hero__eyebrow {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* lilac-200 sits at roughly 3:1 against the mid-tones of the photo;
       lilac-100 clears 4.5:1 with the scrim behind it. */
    color: var(--c-lilac-100);
  }

  .hero__names {
    margin-block-start: var(--sp-2);
    font-size: var(--step-4);
    color: var(--c-white);
  }

  .hero__date {
    margin-block-start: var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .hero__venue {
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--c-white) 80%, transparent);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    margin-block-start: var(--sp-5);
  }

  .hero__actions .button {
    background: var(--c-white);
    color: var(--c-forest-800);
  }

  .hero__actions .button:hover {
    background: var(--c-lilac-100);
  }

  .hero__actions-note {
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--c-white) 75%, transparent);
  }

  /* ---- Countdown ---- */

  .countdown-band {
    padding-block: var(--sp-6);
  }

  /* ---- Save the date ---- */

  .save {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .save {
      grid-template-columns: 1fr 28rem;
    }
  }

  .save__text {
    max-width: var(--measure);
  }

  .save__friday {
    font-weight: 600;
    color: var(--c-forest-700);
  }

  .save__thursday {
    padding: var(--sp-4);
    border-inline-start: 3px solid var(--c-lilac-400);
    background: var(--c-white);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--c-text-muted);
  }

  .save__figure {
    margin: 0;
  }

  .save :global(.save__image) {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  /* ---- Next up ---- */

  .next {
    display: grid;
    gap: var(--sp-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 42rem) {
    .next {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .next__card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    height: 100%;
    padding: var(--sp-5);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background: var(--c-white);
    text-decoration: none;
    transition:
      border-color 140ms ease,
      transform 140ms ease;
  }

  .next__card:hover {
    border-color: var(--c-lilac-400);
    transform: translateY(-2px);
  }

  .next__label {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--c-forest-800);
  }

  .next__desc {
    font-size: var(--step--1);
    color: var(--c-text-muted);
  }
</style>
